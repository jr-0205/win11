<Window x:Class="Windows11Optimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 11 Optimizer" Height="780" Width="1160"
        MinHeight="620" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        SizeChanged="MainWindow_SizeChanged"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Margin="0,0,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Windows 11 Optimizer"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Optimiza Windows sin perder funciones importantes"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <CheckBox x:Name="DarkModeToggle"
                              Content="Tema oscuro"
                              HorizontalAlignment="Right"
                              Margin="0,0,0,4"
                              Checked="DarkModeToggle_Checked"
                              Unchecked="DarkModeToggle_Unchecked"/>
                    <TextBlock x:Name="AdminText"
                               Text="Administrador: verificando…"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="BackupText"
                               Text="Backup: verificando…"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                x:Name="ToastBorder"
                Visibility="Collapsed"
                CornerRadius="7"
                Padding="10,8"
                Margin="0,0,0,8"
                Background="{DynamicResource AccentBrush}">
            <DockPanel>
                <TextBlock x:Name="ToastIcon"
                           Text="●"
                           Foreground="White"
                           FontWeight="Bold"
                           Margin="0,0,8,0"/>
                <TextBlock x:Name="ToastText"
                           Text="Operación completada"
                           Foreground="White"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Panel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid x:Name="MetricsGrid" Columns="4" Margin="8">
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="CPU" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="CpuText" Text="-- %" FontSize="25" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="RAM" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="RamText" Text="-- %" FontSize="25" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="RAM usada" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="RamGbText" Text="-- GB" FontSize="25" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Procesos" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="ProcessText" Text="--" FontSize="25" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <GroupBox Header="Optimización recomendada">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Margin="4">
                                    Reduce procesos y servicios que no necesitas todo el tiempo. La app conserva seguridad, actualizaciones, audio, Wi-Fi, Bluetooth, touchpad y otras funciones importantes.
                                </TextBlock>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Optimizar ahora" Click="OptimizeSafe_Click"/>
                                    <Button Content="Deshacer cambios" Click="Restore_Click"/>
                                    <Button Content="Crear reporte del equipo" Click="ExportDiagnostic_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Accesos rápidos">
                            <WrapPanel>
                                <Button Content="Configuración de inicio de Windows" Click="OpenStartupSettings_Click"/>
                                <Button Content="Administrador de tareas" Click="OpenTaskManager_Click"/>
                                <Button Content="Servicios" Click="OpenServices_Click"/>
                            </WrapPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Servicios">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Servicios en segundo plano"/>
                        <TextBlock Margin="0,3,0,5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="Aquí puedes decidir qué servicios deben iniciar con Windows y cuáles solo deben funcionar cuando realmente los necesites. La app bloquea automáticamente los servicios que no es seguro modificar."/>
                        <WrapPanel>
                            <Button Content="Activar VMware" Click="StartVmware_Click"/>
                            <Button Content="Pausar VMware" Click="StopVmware_Click"/>
                            <Button Content="Activar utilidades Acer" Click="StartAcer_Click"/>
                            <Button Content="Pausar utilidades Acer" Click="StopAcer_Click"/>
                            <Button Content="Actualizar lista" Click="RefreshServices_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Padding="8"
                            Margin="0,0,0,8"
                            CornerRadius="7"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Margin="0,0,10,0">
                                <TextBlock Text="Servicio seleccionado" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="SelectedServiceText" Text="Ninguno" FontWeight="SemiBold"/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Content="Solo cuando se necesite (Manual)" Click="SetServiceManual_Click" ToolTip="No arranca por sí solo, pero una aplicación puede iniciarlo cuando lo necesite."/>
                                <Button Content="Iniciar con Windows (Automático)" Click="SetServiceAutomatic_Click" ToolTip="Windows intentará iniciarlo durante el arranque."/>
                                <Button Content="Iniciar ahora" Click="StartSelectedService_Click"/>
                                <Button Content="Detener ahora" Click="StopSelectedService_Click"/>
                                <Button Content="No iniciar automáticamente" Click="DisableSelectedService_Click" ToolTip="Disponible solo para servicios bajo demanda aprobados."/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid Grid.Row="2"
                              x:Name="ServicesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionChanged="ServicesGrid_SelectionChanged"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Grupo" Binding="{Binding Group}" Width="110"/>
                            <DataGridTextColumn Header="Servicio" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Nombre técnico" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StateDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Cómo inicia" Binding="{Binding StartModeDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Recomendación" Binding="{Binding PolicyDisplay}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Máquinas virtuales">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="12"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Modo para máquinas virtuales"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="La app detecta automáticamente el estado actual y solo recomendará reiniciar cuando exista un cambio pendiente que realmente lo necesite."/>
                        </StackPanel>
                    </Border>

                    <UniformGrid x:Name="VirtualizationStatusGrid"
                                 Grid.Row="1"
                                 Columns="4"
                                 Margin="0,0,0,8">
                        <Border Margin="4"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Modo configurado"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="VirtualizationBootModeText"
                                           Text="Consultando…"
                                           Margin="0,4,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="4"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Estado de esta sesión"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="VirtualizationCurrentText"
                                           Text="Consultando…"
                                           Margin="0,4,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="4"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Reinicio"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="VirtualizationRestartText"
                                           Text="Consultando…"
                                           Margin="0,4,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="4"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Copia de seguridad"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="VirtualizationBackupText"
                                           Text="Consultando…"
                                           Margin="0,4,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2"
                            Padding="10"
                            Margin="0,0,0,8"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="VirtualizationHelpText"
                                   TextWrapping="Wrap"
                                   Text="Comprobando el estado de virtualización…"/>
                    </Border>

                    <StackPanel Grid.Row="3">
                        <WrapPanel>
                            <Button x:Name="UseNormalVirtualizationButton"
                                    Content="Usar modo normal"
                                    Click="SetVirtualizationNormal_Click"
                                    ToolTip="Permite que Windows cargue su hipervisor cuando sea necesario."/>
                            <Button x:Name="UseVmwareVirtualizationButton"
                                    Content="Preparar para VMware"
                                    Click="SetVirtualizationVmware_Click"
                                    ToolTip="Evita que el hipervisor de Windows se cargue en el próximo arranque."/>
                            <Button Content="Volver al estado original"
                                    Click="RestoreVirtualization_Click"/>
                            <Button Content="Actualizar estado"
                                    Click="RefreshVirtualization_Click"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="RestartForVirtualizationButton"
                                    Content="Reiniciar para aplicar"
                                    Click="RestartForVirtualization_Click"
                                    IsEnabled="False"/>
                            <TextBlock x:Name="VirtualizationRestartHintText"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="No hay cambios pendientes que requieran reinicio."/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Inicio de Windows">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Programas que se abren con Windows"/>
                        <TextBlock Margin="0,3,0,5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="La app intenta comprobar si el programa de cada entrada todavía existe. Si una aplicación fue desinstalada pero dejó una referencia antigua, aparecerá como entrada huérfana."/>
                        <WrapPanel>
                            <Button Content="Actualizar lista"
                                    Click="RefreshStartup_Click"/>
                            <Button Content="Administrar en Windows"
                                    Click="OpenStartupSettings_Click"/>
                            <Button Content="Quitar entrada huérfana"
                                    Click="RemoveOrphanedStartup_Click"
                                    ToolTip="Solo elimina la referencia de inicio seleccionada cuando el archivo del programa ya no existe."/>
                            <Button x:Name="RestoreStartupEntryButton"
                                    Content="Restaurar última entrada"
                                    Click="RestoreStartupEntry_Click"
                                    IsEnabled="False"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Padding="9"
                            Margin="0,0,0,8"
                            CornerRadius="7"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="StartupSummaryText"
                                   Text="Analizando programas de inicio…"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <DataGrid Grid.Row="2"
                              x:Name="StartupGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Name}"
                                                Width="210"/>
                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding StatusDisplay}"
                                                Width="220"/>
                            <DataGridTextColumn Header="Origen"
                                                Binding="{Binding Source}"
                                                Width="190"/>
                            <DataGridTextColumn Header="Programa detectado"
                                                Binding="{Binding TargetDisplay}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Opciones de WinUtil">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="Ideas de optimización de WinUtil"/>
                            <TextBlock TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}">
                                Aquí puedes consultar opciones conocidas de WinUtil explicadas en español. Son solo informativas: Windows11Optimizer no aplica ninguna de ellas automáticamente ni ejecuta código remoto.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <WrapPanel DockPanel.Dock="Left">
                            <Button Content="Ver opciones" Click="LoadWinUtil_Click"/>
                            <Button Content="Actualizar lista" Click="RefreshWinUtil_Click"/>
                            <Button Content="Ver proyecto original" Click="OpenWinUtilRepo_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="WinUtilStatusText"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="WinUtil 26.08.19 · sin cargar"/>
                    </DockPanel>

                    <DataGrid Grid.Row="2"
                              x:Name="WinUtilGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              EnableRowVirtualization="True"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nivel" Binding="{Binding Risk}" Width="85"/>
                            <DataGridTextColumn Header="Opción" Binding="{Binding Content}" Width="220"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="170"/>
                            <DataGridTextColumn Header="Perfiles" Binding="{Binding Presets}" Width="170"/>
                            <DataGridTextColumn Header="Qué modifica" Binding="{Binding Actions}" Width="190"/>
                            <DataGridTextColumn Header="Qué hace" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Detalles técnicos">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             x:Name="LogBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                    <Button Grid.Row="1"
                            Content="Limpiar registro"
                            HorizontalAlignment="Right"
                            Click="ClearLog_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Padding="10,7"
                CornerRadius="7"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ActivityDot"
                        Grid.Column="0"
                        Width="10"
                        Height="10"
                        CornerRadius="5"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SuccessBrush}"/>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusText"
                               Text="Listo"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="LastActionText"
                               Text="Esperando una acción"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>

                <ProgressBar x:Name="ActivityProgress"
                             Grid.Column="2"
                             Width="180"
                             Height="7"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
