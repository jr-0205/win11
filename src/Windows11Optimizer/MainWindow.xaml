<Window x:Class="Windows11Optimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Windows 11 Optimizer" Height="780" Width="1160"
        MinHeight="620" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        SizeChanged="MainWindow_SizeChanged"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                CornerRadius="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Windows 11 Optimizer"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Optimiza Windows sin perder funciones importantes"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <CheckBox x:Name="DarkModeToggle"
                              Content="Tema oscuro"
                              HorizontalAlignment="Right"
                              Margin="0,0,0,4"
                              Checked="DarkModeToggle_Checked"
                              Unchecked="DarkModeToggle_Unchecked"/>
                    <TextBlock x:Name="AdminText"
                               Text="Administrador: verificando…"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="BackupText"
                               Text="Backup: verificando…"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter"
                              Grid.Row="1"
                              Margin="0,0,0,8"
                              HorizontalAlignment="Stretch"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="188"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="10"
                    CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Navegación"
                                   Margin="8,4,8,10"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>

                        <TextBlock Text="PRINCIPAL"
                                   Margin="10,2,8,4"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                        <RadioButton x:Name="NavHome"
                                     GroupName="MainNavigation"
                                     Tag="0"
                                     Content="Resumen"
                                     IsChecked="True"
                                     Checked="NavigationButton_Checked"
                                     Style="{StaticResource SidebarNavRadioButtonStyle}"/>
                        <RadioButton GroupName="MainNavigation"
                                     Tag="2"
                                     Content="Optimización"
                                     Checked="NavigationButton_Checked"
                                     Style="{StaticResource SidebarNavRadioButtonStyle}"/>
                        <RadioButton GroupName="MainNavigation"
                                     Tag="1"
                                     Content="Focus Boost"
                                     Checked="NavigationButton_Checked"
                                     Style="{StaticResource SidebarNavRadioButtonStyle}"/>

                        <TextBlock Text="SISTEMA"
                                   Margin="10,12,8,4"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                        <RadioButton GroupName="MainNavigation"
                                     Tag="3"
                                     Content="Virtualización"
                                     Checked="NavigationButton_Checked"
                                     Style="{StaticResource SidebarNavRadioButtonStyle}"/>
                        <RadioButton GroupName="MainNavigation"
                                     Tag="4"
                                     Content="Inicio de Windows"
                                     Checked="NavigationButton_Checked"
                                     Style="{StaticResource SidebarNavRadioButtonStyle}"/>
                        <RadioButton GroupName="MainNavigation"
                                     Tag="5"
                                     Content="Aplicaciones"
                                     Checked="NavigationButton_Checked"
                                     Style="{StaticResource SidebarNavRadioButtonStyle}"/>

                        <TextBlock Text="HERRAMIENTAS"
                                   Margin="10,12,8,4"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                        <RadioButton GroupName="MainNavigation"
                                     Tag="6"
                                     Content="Ajustes seguros"
                                     Checked="NavigationButton_Checked"
                                     Style="{StaticResource SidebarNavRadioButtonStyle}"/>
                        <RadioButton GroupName="MainNavigation"
                                     Tag="7"
                                     Content="Registro técnico"
                                     Checked="NavigationButton_Checked"
                                     Style="{StaticResource SidebarNavRadioButtonStyle}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom"
                                VerticalAlignment="Bottom"
                                Margin="4,12,4,4">
                        <Button Content="Mini Focus"
                                Click="OpenMiniFocus_Click"
                                HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Cambios reversibles · IA opcional"
                                   Margin="6,8,6,0"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TabControl x:Name="MainTabs"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent"/>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="Resumen">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4">
                        <TextBlock Text="Resumen del equipo"
                                   Margin="8,4,8,2"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Estado general y acceso rápido a las funciones principales."
                                   Margin="8,0,8,12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>

                        <UniformGrid x:Name="MetricsGrid"
                                     Columns="4"
                                     Margin="4,0,4,10">
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="CPU"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="CpuText"
                                               Text="-- %"
                                               Margin="0,4,0,0"
                                               FontSize="25"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="RAM"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="RamText"
                                               Text="-- %"
                                               Margin="0,4,0,0"
                                               FontSize="25"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="RAM usada"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="RamGbText"
                                               Text="-- GB"
                                               Margin="0,4,0,0"
                                               FontSize="25"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Procesos"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="ProcessText"
                                               Text="--"
                                               Margin="0,4,0,0"
                                               FontSize="25"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Margin="8,0,8,10"
                                Padding="18"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,18,0">
                                    <TextBlock Text="Estado del equipo"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SmartAnalysisText"
                                               Margin="0,7,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Text="Analizando los componentes que pueden optimizarse sin quitar funciones…"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <Button Content="Analizar"
                                            Click="AnalyzeComputer_Click"/>
                                    <Button Content="Crear reporte"
                                            Click="ExportDiagnostic_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="8,0,8,8"
                                Padding="14"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="Los cambios automáticos están limitados a acciones conocidas y reversibles. Para mejorar rendimiento temporal usa Focus Boost; para cambios permanentes usa Optimización."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Focus Boost">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="18"
                            Margin="0,0,0,12"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Focus Boost"
                                       FontSize="22"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="FocusBoostStatusText"
                                       Margin="0,6,0,0"
                                       Text="Focus Boost inactivo"
                                       TextWrapping="Wrap"/>
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Text="Da prioridad moderada a una aplicación mientras la usas y restaura el estado al terminar. No usa prioridad Alta/Tiempo real ni modifica procesos críticos."/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Padding="12"
                            Margin="0,0,0,12"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <WrapPanel>
                            <Button Content="Actualizar lista"
                                    Click="RefreshFocusProcesses_Click"/>
                            <Button Content="Iniciar"
                                    Click="StartFocusBoost_Click"/>
                            <Button Content="Detener y restaurar"
                                    Click="StopFocusBoost_Click"/>
                            <Button Content="Mini Focus"
                                    Click="OpenMiniFocus_Click"/>
                            <Button Content="Atajos de teclado"
                                    Click="OpenAgentSettings_Click"/>
                        </WrapPanel>
                    </Border>

                    <DataGrid Grid.Row="2"
                              x:Name="FocusProcessGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Aplicación / proceso"
                                                Binding="{Binding DisplayName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="PID"
                                                Binding="{Binding Pid}"
                                                Width="80"/>
                            <DataGridTextColumn Header="RAM"
                                                Binding="{Binding WorkingSetMb, StringFormat={}{0:N0} MB}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Prioridad actual"
                                                Binding="{Binding Priority}"
                                                Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Optimización">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Text="Optimización segura"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,14"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="Empieza por el examen local. Solo propone cambios conocidos y reversibles; la IA es una ayuda opcional."/>

                        <Border Padding="16"
                                Margin="0,0,0,12"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Examen local"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="SmartOptimizationSummaryText"
                                           Margin="0,6,0,0"
                                           Text="Preparando análisis…"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="OptimizationResultText"
                                           Margin="0,4,0,0"
                                           Text="Todavía no se han aplicado cambios en esta sesión."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Analizar"
                                            Click="AnalyzeOptimization_Click"/>
                                    <Button x:Name="ApplySmartOptimizationButton"
                                            Content="Aplicar cambios seguros"
                                            Click="ApplySmartOptimization_Click"
                                            IsEnabled="False"/>
                                    <Button Content="Deshacer cambios"
                                            Click="Restore_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Recomendaciones locales"
                                   Margin="2,2,0,8"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <DataGrid x:Name="OptimizationPlanGrid"
                                  Height="250"
                                  Margin="0,0,0,12"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Elemento"
                                                    Binding="{Binding Title}"
                                                    Width="220"/>
                                <DataGridTextColumn Header="Estado"
                                                    Binding="{Binding Status}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Acción segura"
                                                    Binding="{Binding Action}"
                                                    Width="1.6*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Expander Header="Asistente con IA (opcional)"
                                  IsExpanded="False"
                                  Margin="0,0,0,8">
                            <Border Padding="16"
                                    Margin="0,6,0,0"
                                    CornerRadius="10"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock x:Name="AiExamStatusText"
                                                   DockPanel.Dock="Left"
                                                   MaxWidth="620"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Text="Requiere una clave API con saldo. Si OpenAI no está disponible, la app usa el examen local y no aplica nada automáticamente."/>
                                        <Button DockPanel.Dock="Right"
                                                Content="Mejorar con IA"
                                                Click="RunAiExam_Click"/>
                                    </DockPanel>

                                    <DataGrid x:Name="AiRecommendationGrid"
                                              Height="190"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              SelectionMode="Single"
                                              SelectionChanged="AiRecommendationGrid_SelectionChanged"
                                              AlternationCount="2">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Recomendación"
                                                                Binding="{Binding Title}"
                                                                Width="220"/>
                                            <DataGridTextColumn Header="Motivo"
                                                                Binding="{Binding Reason}"
                                                                Width="*"/>
                                            <DataGridTextColumn Header="Riesgo"
                                                                Binding="{Binding Risk}"
                                                                Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock x:Name="AiRecommendationDetailText"
                                               Margin="0,10,0,0"
                                               Text="Selecciona una recomendación para ver impacto y cómo revertirla."
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="ApplyAiRecommendationButton"
                                                Content="Aplicar con motor seguro"
                                                Click="ApplyAiRecommendation_Click"
                                                IsEnabled="False"/>
                                        <Button x:Name="RevertAiRecommendationButton"
                                                Content="Deshacer este ajuste"
                                                Click="RevertAiRecommendation_Click"
                                                IsEnabled="False"/>
                                    </WrapPanel>

                                    <TextBlock Margin="4,10,4,0"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Text="La IA solo recibe un resumen técnico limitado y el catálogo seguro. No ejecuta comandos ni inventa acciones."/>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Virtualización">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <Border Padding="14"
                                Margin="0,0,0,8"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Elige cómo quieres usar la virtualización"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           Text="La app prepara automáticamente los componentes necesarios. No necesitas administrar servicios ni opciones técnicas por separado."/>
                            </StackPanel>
                        </Border>

                        <UniformGrid x:Name="VirtualizationStatusGrid"
                                     Columns="2"
                                     Margin="0,0,0,8">
                            <Border Margin="4"
                                    Padding="12"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Modo elegido"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="VirtualizationBootModeText"
                                               Text="Consultando…"
                                               Margin="0,4,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="4"
                                    Padding="12"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Reinicio"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="VirtualizationRestartText"
                                               Text="Consultando…"
                                               Margin="0,4,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Margin="0,0,4,0"
                                    Padding="16"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Windows y Docker"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Text="Prioriza Docker Desktop, WSL2, Windows Sandbox y las funciones de virtualización y seguridad de Windows."/>
                                    <TextBlock Margin="0,10,0,0"
                                               TextWrapping="Wrap"
                                               Text="Los componentes de VMware quedan disponibles cuando los necesites. Además, la app repara automáticamente WSL y los componentes de virtualización de Windows si alguno quedó deshabilitado."/>
                                    <Button x:Name="UseNormalVirtualizationButton"
                                            Margin="0,14,0,0"
                                            Content="Usar Windows y Docker"
                                            Click="SetVirtualizationNormal_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Padding="16"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="VMware"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Text="Prioriza VMware, las máquinas virtuales y los casos donde necesitas virtualización anidada sin interferencia del modo de virtualización de Windows."/>
                                    <TextBlock x:Name="VmwareServiceProfileText"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"
                                               Text="Comprobando componentes VMware…"/>
                                    <Button x:Name="UseVmwareVirtualizationButton"
                                            Margin="0,14,0,0"
                                            Content="Usar VMware"
                                            Click="SetVirtualizationVmware_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Padding="10"
                                Margin="4,0,4,8"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="VirtualizationHelpText"
                                       TextWrapping="Wrap"
                                       Text="Comprobando el estado actual…"/>
                        </Border>

                        <WrapPanel>
                            <Button Content="Volver al estado original"
                                    Click="RestoreVirtualization_Click"/>
                            <Button Content="Actualizar estado"
                                    Click="RefreshVirtualization_Click"/>
                            <Button x:Name="RestartForVirtualizationButton"
                                    Content="Reiniciar para aplicar"
                                    Click="RestartForVirtualization_Click"
                                    IsEnabled="False"/>
                            <TextBlock x:Name="VirtualizationRestartHintText"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="No hay cambios pendientes."/>
                        </WrapPanel>

                        <Expander Header="Información técnica"
                                  Margin="4,10,4,0">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="VirtualizationCurrentText"
                                           Text="Consultando hipervisor…"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="VirtualizationVbsText"
                                           Margin="0,4,0,0"
                                           Text="Consultando seguridad basada en virtualización…"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="VirtualizationMemoryIntegrityText"
                                           Margin="0,4,0,0"
                                           Text="Consultando integridad de memoria…"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="VirtualizationBackupText"
                                           Margin="0,4,0,0"
                                           Text="Consultando copia de seguridad…"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="StartupTab" Header="Inicio de Windows">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Programas que se abren con Windows"/>
                        <TextBlock Margin="0,3,0,5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="La app intenta comprobar si el programa de cada entrada todavía existe. Si una aplicación fue desinstalada pero dejó una referencia antigua, aparecerá como entrada huérfana."/>
                        <WrapPanel>
                            <Button Content="Actualizar lista"
                                    Click="RefreshStartup_Click"/>
                            <Button Content="Administrar en Windows"
                                    Click="OpenStartupSettings_Click"/>
                            <Button Content="No iniciar con Windows"
                                    Click="DisableStartupEntry_Click"
                                    ToolTip="Retira de forma reversible la entrada seleccionada del inicio. No desinstala ni borra el programa."/>
                            <Button Content="Quitar entrada huérfana"
                                    Click="RemoveOrphanedStartup_Click"
                                    ToolTip="Solo elimina la referencia de inicio seleccionada cuando el archivo del programa ya no existe."/>
                            <Button x:Name="RestoreStartupEntryButton"
                                    Content="Restaurar último cambio"
                                    Click="RestoreStartupEntry_Click"
                                    IsEnabled="False"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Padding="9"
                            Margin="0,0,0,8"
                            CornerRadius="7"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="StartupSummaryText"
                                   Text="Analizando programas de inicio…"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <DataGrid Grid.Row="2"
                              x:Name="StartupGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              AlternationCount="2"
                              PreviewMouseRightButtonDown="StartupGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource ForegroundBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1"
                                         Padding="4">
                                <MenuItem Header="Abrir ubicación"
                                          Click="OpenStartupEntryLocation_Click"
                                          ToolTip="Abre en el Explorador la carpeta del programa asociado a la entrada seleccionada."/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Name}"
                                                Width="210"/>
                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding StatusDisplay}"
                                                Width="220"/>
                            <DataGridTextColumn Header="Origen"
                                                Binding="{Binding Source}"
                                                Width="190"/>
                            <DataGridTextColumn Header="Programa detectado"
                                                Binding="{Binding TargetDisplay}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Expander Grid.Row="3"
                              Header="Análisis avanzado con Microsoft Autoruns"
                              Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="AutorunsStatusText"
                                       Margin="4"
                                       TextWrapping="Wrap"
                                       Text="Comprobando si Autoruns está disponible…"/>
                            <WrapPanel>
                                <Button Content="Analizar con Autoruns"
                                        Click="AnalyzeAutoruns_Click"/>
                                <Button Content="Abrir / obtener Autoruns"
                                        Click="OpenAutoruns_Click"/>
                            </WrapPanel>
                            <DataGrid x:Name="AutorunsFindingsGrid"
                                      Height="180"
                                      Margin="4,6,4,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Entrada"
                                                        Binding="{Binding NameDisplay}"
                                                        Width="220"/>
                                    <DataGridTextColumn Header="Estado"
                                                        Binding="{Binding StatusDisplay}"
                                                        Width="160"/>
                                    <DataGridTextColumn Header="Tipo"
                                                        Binding="{Binding SourceDisplay}"
                                                        Width="170"/>
                                    <DataGridTextColumn Header="Programa"
                                                        Binding="{Binding ImagePath}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="Aplicaciones">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="14"
                            Margin="0,0,0,8"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Aplicaciones instaladas"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="InstalledAppsSummaryText"
                                       Margin="0,4,0,0"
                                       Text="Cargando aplicaciones…"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Actualizar"
                                        Click="RefreshInstalledApps_Click"/>
                                <Button Content="Desinstalar seleccionada"
                                        Click="UninstallSelectedApp_Click"/>
                                <Button Content="Abrir ubicación"
                                        Click="OpenSelectedAppLocation_Click"/>
                                <Button Content="Explicar con IA"
                                        Click="ExplainSelectedAppWithAi_Click"/>
                                <Button Content="Configuración de Windows"
                                        Click="OpenAppsSettings_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="InstalledAppsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionChanged="InstalledAppsGrid_SelectionChanged"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Aplicación"
                                                Binding="{Binding DisplayName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Versión"
                                                Binding="{Binding VersionDisplay}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Editor"
                                                Binding="{Binding PublisherDisplay}"
                                                Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Padding="12"
                            Margin="0,8,0,0"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="SelectedAppDetailText"
                                       Text="Selecciona una aplicación para ver sus datos."
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="AppAiExplanationText"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="La explicación con IA usa únicamente nombre, versión y editor."/>
                        </StackPanel>
                    </Border>

                    <Expander Grid.Row="3"
                              Header="Residuos confirmados de inicio"
                              Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ResidueSummaryText"
                                       Margin="4"
                                       Text="Analizando referencias antiguas…"
                                       TextWrapping="Wrap"/>
                            <DataGrid x:Name="ResidueGrid"
                                      Height="150"
                                      Margin="4"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Referencia"
                                                        Binding="{Binding Name}"
                                                        Width="220"/>
                                    <DataGridTextColumn Header="Origen"
                                                        Binding="{Binding Source}"
                                                        Width="180"/>
                                    <DataGridTextColumn Header="Programa"
                                                        Binding="{Binding TargetDisplay}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel>
                                <Button Content="Quitar referencia seleccionada"
                                        Click="RemoveSelectedResidue_Click"/>
                                <Button Content="Restaurar última referencia"
                                        Click="RestoreResidue_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="Ajustes seguros">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="14"
                            Margin="0,0,0,8"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Ajustes sencillos"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="Solo se muestran opciones que Windows11Optimizer puede aplicar y deshacer directamente. Las opciones complejas del catálogo de WinUtil ya no aparecen en la interfaz."/>
                            <TextBlock x:Name="WinUtilStatusText"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="Cargando ajustes…"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  x:Name="WinUtilGrid"
                                  Margin="0,0,8,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionChanged="WinUtilGrid_SelectionChanged"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ajuste"
                                                    Binding="{Binding Content}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Column="1"
                                Padding="16"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="WinUtilSelectedTitleText"
                                           Text="Selecciona un ajuste"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="WinUtilSelectedStateText"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           Text="Sin seleccionar"/>

                                <TextBlock Text="Qué hace"
                                           Margin="0,18,0,4"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="WinUtilSelectedDescriptionText"
                                           Text="Selecciona un ajuste para ver una explicación sencilla."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>

                                <TextBlock Text="Qué cambia"
                                           Margin="0,18,0,4"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="WinUtilSelectedImpactText"
                                           Text="No se realizará ningún cambio hasta que pulses Aplicar."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>

                                <TextBlock Text="Riesgo"
                                           Margin="0,16,0,4"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="WinUtilSelectedRiskText"
                                           Text="Muy bajo"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>

                                <TextBlock Text="Cómo se deshace"
                                           Margin="0,16,0,4"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="WinUtilSelectedRevertText"
                                           Text="La app guarda el valor anterior antes de aplicar."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>

                                <WrapPanel Margin="0,16,0,0">
                                    <Button x:Name="WinUtilApplyButton"
                                            Content="Aplicar"
                                            Click="ApplySelectedWinUtil_Click"
                                            IsEnabled="False"/>
                                    <Button x:Name="WinUtilRestoreButton"
                                            Content="Deshacer"
                                            Click="RestoreSelectedWinUtil_Click"
                                            IsEnabled="False"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Registro técnico">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             x:Name="LogBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                    <Button Grid.Row="1"
                            Content="Limpiar registro"
                            HorizontalAlignment="Right"
                            Click="ClearLog_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Padding="10,7"
                CornerRadius="7"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ActivityDot"
                        Grid.Column="0"
                        Width="10"
                        Height="10"
                        CornerRadius="5"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SuccessBrush}"/>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusText"
                               Text="Listo"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="LastActionText"
                               Text="Esperando una acción"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>

                <ProgressBar x:Name="ActivityProgress"
                             Grid.Column="2"
                             Width="180"
                             Height="7"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
