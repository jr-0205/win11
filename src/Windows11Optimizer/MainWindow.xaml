<Window x:Class="Windows11Optimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 11 Optimizer" Height="780" Width="1160"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Margin="0,0,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Windows 11 Optimizer"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Optimización reversible · Perfil seguro · Servicios bajo demanda"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <CheckBox x:Name="DarkModeToggle"
                              Content="Tema oscuro"
                              HorizontalAlignment="Right"
                              Margin="0,0,0,4"
                              Checked="DarkModeToggle_Checked"
                              Unchecked="DarkModeToggle_Unchecked"/>
                    <TextBlock x:Name="AdminText"
                               Text="Administrador: verificando…"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="BackupText"
                               Text="Backup: verificando…"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                x:Name="ToastBorder"
                Visibility="Collapsed"
                CornerRadius="7"
                Padding="10,8"
                Margin="0,0,0,8"
                Background="{DynamicResource AccentBrush}">
            <DockPanel>
                <TextBlock x:Name="ToastIcon"
                           Text="●"
                           Foreground="White"
                           FontWeight="Bold"
                           Margin="0,0,8,0"/>
                <TextBlock x:Name="ToastText"
                           Text="Operación completada"
                           Foreground="White"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Panel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid Columns="4" Margin="8">
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="CPU" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="CpuText" Text="-- %" FontSize="25" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="RAM" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="RamText" Text="-- %" FontSize="25" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="RAM usada" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="RamGbText" Text="-- GB" FontSize="25" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Procesos" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock x:Name="ProcessText" Text="--" FontSize="25" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <GroupBox Header="Perfil seguro">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Margin="4">
                                    Detiene y evita el arranque automático de servicios seleccionados de VMware y utilidades Acer no esenciales. No modifica Defender, Windows Update, búsqueda, audio, Wi-Fi, Bluetooth, touchpad, AMD Graphics ni Quick Access.
                                </TextBlock>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Aplicar optimización segura" Click="OptimizeSafe_Click"/>
                                    <Button Content="Restaurar configuración" Click="Restore_Click"/>
                                    <Button Content="Exportar diagnóstico" Click="ExportDiagnostic_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Accesos rápidos">
                            <WrapPanel>
                                <Button Content="Configuración de inicio de Windows" Click="OpenStartupSettings_Click"/>
                                <Button Content="Administrador de tareas" Click="OpenTaskManager_Click"/>
                                <Button Content="Servicios" Click="OpenServices_Click"/>
                            </WrapPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Servicios seguros">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Administrador seguro de servicios"/>
                        <TextBlock Margin="0,3,0,5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="Selecciona un servicio aprobado. Puedes cambiarlo entre Automático y Manual, iniciarlo o detenerlo. Solo los servicios bajo demanda aprobados permiten Deshabilitado. Los servicios protegidos se muestran únicamente como referencia."/>
                        <WrapPanel>
                            <Button Content="Iniciar VMware" Click="StartVmware_Click"/>
                            <Button Content="Detener VMware" Click="StopVmware_Click"/>
                            <Button Content="Iniciar utilidades Acer" Click="StartAcer_Click"/>
                            <Button Content="Detener utilidades Acer" Click="StopAcer_Click"/>
                            <Button Content="Actualizar" Click="RefreshServices_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Padding="8"
                            Margin="0,0,0,8"
                            CornerRadius="7"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Margin="0,0,10,0">
                                <TextBlock Text="Servicio seleccionado" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="SelectedServiceText" Text="Ninguno" FontWeight="SemiBold"/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Content="Manual" Click="SetServiceManual_Click" ToolTip="No arranca por sí solo, pero una aplicación puede iniciarlo cuando lo necesite."/>
                                <Button Content="Automático" Click="SetServiceAutomatic_Click" ToolTip="Windows intentará iniciarlo durante el arranque."/>
                                <Button Content="Iniciar ahora" Click="StartSelectedService_Click"/>
                                <Button Content="Detener ahora" Click="StopSelectedService_Click"/>
                                <Button Content="Deshabilitar arranque" Click="DisableSelectedService_Click" ToolTip="Disponible solo para servicios bajo demanda aprobados."/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid Grid.Row="2"
                              x:Name="ServicesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionChanged="ServicesGrid_SelectionChanged"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Grupo" Binding="{Binding Group}" Width="110"/>
                            <DataGridTextColumn Header="Servicio" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Nombre interno" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="110"/>
                            <DataGridTextColumn Header="Inicio" Binding="{Binding StartMode}" Width="110"/>
                            <DataGridTextColumn Header="Política" Binding="{Binding Policy}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Virtualización">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="12"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Selector del hipervisor de Windows"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="Controla hypervisorlaunchtype para el próximo arranque. AUTO conserva el hipervisor de Windows; OFF evita que se cargue al reiniciar. Esto no cambia la virtualización del BIOS."/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,8">
                        <Border Margin="4"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Próximo arranque"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="VirtualizationBootModeText"
                                           Text="Consultando…"
                                           Margin="0,4,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="4"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Hipervisor ahora"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="VirtualizationCurrentText"
                                           Text="Consultando…"
                                           Margin="0,4,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="4"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Backup"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="VirtualizationBackupText"
                                           Text="Consultando…"
                                           Margin="0,4,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2"
                            Padding="10"
                            Margin="0,0,0,8"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <TextBlock TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Importante: "/>
                            <Run Text="el cambio solo se aplica después de reiniciar. Con el hipervisor en OFF, Hyper-V y otras funciones que dependen del hipervisor de Windows pueden dejar de estar disponibles hasta volver a AUTO y reiniciar."/>
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Row="3">
                        <WrapPanel>
                            <Button Content="Modo Normal · AUTO"
                                    Click="SetVirtualizationNormal_Click"
                                    ToolTip="Configura hypervisorlaunchtype=auto para el próximo arranque."/>
                            <Button Content="Modo VMware directo · OFF"
                                    Click="SetVirtualizationVmware_Click"
                                    ToolTip="Configura hypervisorlaunchtype=off para el próximo arranque."/>
                            <Button Content="Restaurar valor original"
                                    Click="RestoreVirtualization_Click"/>
                            <Button Content="Actualizar estado"
                                    Click="RefreshVirtualization_Click"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Reiniciar ahora"
                                    Click="RestartForVirtualization_Click"/>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="Puedes reiniciar más tarde; la configuración quedará preparada."/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Inicio">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="La aplicación inventaría las entradas de inicio y abre la pantalla oficial de Windows para habilitarlas o deshabilitarlas de forma segura."/>
                        <Button DockPanel.Dock="Right"
                                Content="Abrir Apps de inicio"
                                Click="OpenStartupSettings_Click"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              x:Name="StartupGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="Origen" Binding="{Binding Source}" Width="180"/>
                            <DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="WinUtil · catálogo">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="Integración segura de Chris Titus Tech WinUtil"/>
                            <TextBlock TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}">
                                Esta pestaña importa únicamente el catálogo JSON desde una versión fijada del repositorio oficial. No ejecuta irm|iex, no descarga PowerShell ejecutable y ningún tweak de WinUtil puede aplicarse automáticamente desde esta versión de Windows11Optimizer.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <WrapPanel DockPanel.Dock="Left">
                            <Button Content="Cargar catálogo fijado" Click="LoadWinUtil_Click"/>
                            <Button Content="Actualizar caché" Click="RefreshWinUtil_Click"/>
                            <Button Content="Abrir repo oficial" Click="OpenWinUtilRepo_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="WinUtilStatusText"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="WinUtil 26.08.19 · sin cargar"/>
                    </DockPanel>

                    <DataGrid Grid.Row="2"
                              x:Name="WinUtilGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              EnableRowVirtualization="True"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Riesgo" Binding="{Binding Risk}" Width="85"/>
                            <DataGridTextColumn Header="Tweak" Binding="{Binding Content}" Width="220"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="170"/>
                            <DataGridTextColumn Header="Presets" Binding="{Binding Presets}" Width="170"/>
                            <DataGridTextColumn Header="Acciones" Binding="{Binding Actions}" Width="190"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Registro">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             x:Name="LogBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                    <Button Grid.Row="1"
                            Content="Limpiar registro"
                            HorizontalAlignment="Right"
                            Click="ClearLog_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Padding="10,7"
                CornerRadius="7"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ActivityDot"
                        Grid.Column="0"
                        Width="10"
                        Height="10"
                        CornerRadius="5"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SuccessBrush}"/>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusText"
                               Text="Listo"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="LastActionText"
                               Text="Esperando una acción"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>

                <ProgressBar x:Name="ActivityProgress"
                             Grid.Column="2"
                             Width="180"
                             Height="7"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
